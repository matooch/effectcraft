<!-- 04_hierarchy: a parent Node "Arm" at (250,250) rotating 0 -> 90deg and scaling
     1 -> 0.75 over 2 s (30 fps). Its child Shape "Upper" is a bar whose pivot is its
     left edge (originX 0). A nested Node "Elbow" at the bar's end holds Shape "Hand",
     which spins 0 -> 360deg on its own. Tests parenting, local vs world transforms
     and non-centred origins. -->
<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:90" width="500" height="500" name="Hierarchy" id="0:1">
        <Fill name="Background">
            <SolidColor colorValue="FF1D1D1D" name="Color"/>
        </Fill>
        <Node x="250" y="250" name="Arm" id="0:10">
            <Shape x="0" y="0" name="Upper" id="0:11">
                <Rectangle width="150" height="30" originX="0" originY="0.5" name="Bar"/>
                <Fill name="Fill"><SolidColor colorValue="FF57A5E0" name="Color"/></Fill>
            </Shape>
            <Node x="150" y="0" name="Elbow" id="0:12">
                <Shape x="0" y="0" name="Hand" id="0:13">
                    <Rectangle width="60" height="20" originX="0.5" originY="0.5" name="Paddle"/>
                    <Fill name="Fill"><SolidColor colorValue="FFE0A557" name="Color"/></Fill>
                </Shape>
            </Node>
        </Node>
        <StateMachine name="SM" id="0:90">
            <StateMachineLayer name="Layer" id="0:91">
                <AnyState x="300" y="-100"/>
                <ExitState x="450" y="-100"/>
                <EntryState x="0" y="0"><StateTransition stateToId="0:92"/></EntryState>
                <AnimationState animationId="0:20" x="150" y="0" id="0:92"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation fps="30" duration="60" loopValue="oneShot" name="swing" id="0:20">
            <KeyedObject objectId="0:10">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble frame="0" value="0" interpolationType="linear"/>
                    <KeyFrameDouble frame="60" value="1.5707964" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble frame="0" value="1" interpolationType="linear"/>
                    <KeyFrameDouble frame="60" value="0.75" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble frame="0" value="1" interpolationType="linear"/>
                    <KeyFrameDouble frame="60" value="0.75" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:13">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble frame="0" value="0" interpolationType="linear"/>
                    <KeyFrameDouble frame="60" value="6.2831855" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>
</Rive>
